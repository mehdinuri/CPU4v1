FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    gcovr \
    ca-certificates \
    libasan8 \
    libubsan1 \
    uncrustify \
    && rm -rf /var/lib/apt/lists/*

# Verify toolchain
RUN gcc --version && cmake --version && ninja --version && gcovr --version && uncrustify --version

WORKDIR /workspace

CMD ["bash"]
